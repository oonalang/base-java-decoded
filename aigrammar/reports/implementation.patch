diff --git a/aigrammar/src/com/aigrammar/CloneIdentity.java b/aigrammar/src/com/aigrammar/CloneIdentity.java
new file mode 100644
index 00000000..160da467
--- /dev/null
+++ b/aigrammar/src/com/aigrammar/CloneIdentity.java
@@ -0,0 +1,43 @@
+package com.aigrammar;
+
+import android.content.Context;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.Signature;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+
+/** Recognize this clone's own package and actual signer, not Google's identity. */
+public final class CloneIdentity {
+    // build-helper.sh substitutes the selected keystore's certificate in its staging copy.
+    public static final String EXPECTED_CERT_SHA256 = "835CFD33F94E1CC744655D3E48ABDCD0F56C8F0865AA09C5AEC830B5CE51E233";
+    private static final String PACKAGE = "com.gboard.eli";
+
+    private CloneIdentity() {}
+
+    public static boolean matchesPinnedIdentity(String packageName, byte[] digest) {
+        if (!PACKAGE.equals(packageName) || digest == null || digest.length != 32) return false;
+        byte[] expected = new byte[32];
+        for (int i = 0; i < expected.length; i++) {
+            expected[i] = (byte) Integer.parseInt(EXPECTED_CERT_SHA256.substring(i * 2, i * 2 + 2), 16);
+        }
+        return MessageDigest.isEqual(expected, digest);
+    }
+
+    public static boolean isExpectedSelf(Context context) {
+        if (context == null || !PACKAGE.equals(context.getPackageName())) return false;
+        try {
+            PackageInfo info = context.getPackageManager().getPackageInfo(
+                    PACKAGE, PackageManager.GET_SIGNING_CERTIFICATES);
+            if (!PACKAGE.equals(info.packageName) || info.signingInfo == null) return false;
+            Signature[] signers = info.signingInfo.getApkContentsSigners();
+            if (signers == null || signers.length != 1) return false;
+            return matchesPinnedIdentity(info.packageName,
+                    MessageDigest.getInstance("SHA-256").digest(signers[0].toByteArray()));
+        } catch (PackageManager.NameNotFoundException | NoSuchAlgorithmException error) {
+            return false;
+        } catch (RuntimeException error) {
+            return false;
+        }
+    }
+}
diff --git a/aigrammar/src/com/aigrammar/EditorPolicy.java b/aigrammar/src/com/aigrammar/EditorPolicy.java
new file mode 100644
index 00000000..9aac5d8a
--- /dev/null
+++ b/aigrammar/src/com/aigrammar/EditorPolicy.java
@@ -0,0 +1,28 @@
+package com.aigrammar;
+
+import android.text.InputType;
+import android.view.inputmethod.EditorInfo;
+
+/** Pure predicate, checked before any InputConnection text read. */
+public final class EditorPolicy {
+    private EditorPolicy() {}
+
+    public static boolean allows(int inputType, int imeOptions, String packageName) {
+        if (packageName == null || "com.gboard.eli".equals(packageName)) return false;
+        if ((inputType & InputType.TYPE_MASK_CLASS) != InputType.TYPE_CLASS_TEXT) return false;
+        if ((imeOptions & EditorInfo.IME_FLAG_NO_PERSONALIZED_LEARNING) != 0) return false;
+        if ((inputType & InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS) != 0) return false;
+        switch (inputType & InputType.TYPE_MASK_VARIATION) {
+            case InputType.TYPE_TEXT_VARIATION_PASSWORD:
+            case InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD:
+            case InputType.TYPE_TEXT_VARIATION_WEB_PASSWORD:
+            case InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS:
+            case InputType.TYPE_TEXT_VARIATION_WEB_EMAIL_ADDRESS:
+            case InputType.TYPE_TEXT_VARIATION_EMAIL_SUBJECT:
+            case InputType.TYPE_TEXT_VARIATION_URI:
+                return false;
+            default:
+                return true;
+        }
+    }
+}
diff --git a/aigrammar/src/com/aigrammar/GrammarBridge.java b/aigrammar/src/com/aigrammar/GrammarBridge.java
new file mode 100644
index 00000000..753bc95b
--- /dev/null
+++ b/aigrammar/src/com/aigrammar/GrammarBridge.java
@@ -0,0 +1,327 @@
+package com.aigrammar;
+
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.graphics.Color;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.inputmethodservice.InputMethodService;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserManager;
+import android.text.TextUtils;
+import android.util.Log;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.inputmethod.EditorInfo;
+import android.view.inputmethod.InputConnection;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/** Small platform-only adapter. No reflection into Gboard and no root replacement. */
+public final class GrammarBridge implements SharedPreferences.OnSharedPreferenceChangeListener {
+    private static GrammarBridge instance;
+    // R.id.keyboard_holder, confirmed in res/values/public.xml and layout ...0171.
+    private static final int KEYBOARD_HOLDER = 0x7f0b05e9;
+    private final InputMethodService ime;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final Runnable timer = new Runnable() {
+        @Override public void run() { requestCorrection(); }
+    };
+    private SharedPreferences registered;
+    private LinearLayout row;
+    private TextView toggle;
+    private TextView chip;
+    private EditorInfo editor;
+    private boolean active;
+    private long revision;
+    private int cursorStart = -1;
+    private int cursorEnd = -1;
+    private String lastRequested;
+    private boolean requesting;
+    private Snapshot offered;
+    private String correction;
+
+    private GrammarBridge(InputMethodService ime) { this.ime = ime; }
+
+    private static GrammarBridge get(InputMethodService ime) {
+        if (instance == null || instance.ime != ime) {
+            if (instance != null) instance.dispose();
+            instance = new GrammarBridge(ime);
+        }
+        GrammarClient.init(ime);
+        SharedPreferences prefs = GrammarClient.preferences();
+        if (prefs != null && instance.registered != prefs) {
+            if (instance.registered != null)
+                instance.registered.unregisterOnSharedPreferenceChangeListener(instance);
+            instance.registered = prefs;
+            prefs.registerOnSharedPreferenceChangeListener(instance);
+        }
+        return instance;
+    }
+
+    public static void attach(InputMethodService ime, View root) {
+        try { get(ime).attachRow(root); }
+        catch (RuntimeException error) { Log.w("AIGrammar", "Cannot attach grammar row"); }
+    }
+
+    public static void start(InputMethodService ime, EditorInfo info) {
+        try {
+            GrammarBridge bridge = get(ime);
+            bridge.invalidate();
+            bridge.editor = info;
+            bridge.active = true;
+            bridge.cursorStart = info == null ? -1 : info.initialSelStart;
+            bridge.cursorEnd = info == null ? -1 : info.initialSelEnd;
+            bridge.lastRequested = null;
+            bridge.refreshToggle();
+            if (GrammarClient.isEnabled()) bridge.handler.postDelayed(bridge.timer, 700);
+        } catch (RuntimeException error) { Log.w("AIGrammar", "Cannot start grammar session"); }
+    }
+
+    public static void selection(InputMethodService ime, int start, int end) {
+        if (instance == null || instance.ime != ime) return;
+        GrammarBridge bridge = instance;
+        try {
+            bridge.invalidate();
+            bridge.cursorStart = start;
+            bridge.cursorEnd = end;
+            if (bridge.allowed()) bridge.handler.postDelayed(bridge.timer, 700);
+        } catch (RuntimeException error) { bridge.invalidate(); }
+    }
+
+    public static void suspend(InputMethodService ime) {
+        if (instance == null || instance.ime != ime) return;
+        instance.active = false;
+        instance.invalidate();
+    }
+
+    public static void resume(InputMethodService ime) {
+        if (instance == null || instance.ime != ime) return;
+        instance.active = instance.editor == ime.getCurrentInputEditorInfo();
+        instance.refreshToggle();
+    }
+
+    public static void destroy(InputMethodService ime) {
+        if (instance == null || instance.ime != ime) return;
+        instance.dispose();
+        instance = null;
+    }
+
+    private void dispose() {
+        invalidate();
+        if (registered != null) registered.unregisterOnSharedPreferenceChangeListener(this);
+        registered = null;
+        if (row != null && row.getParent() instanceof ViewGroup)
+            ((ViewGroup) row.getParent()).removeView(row);
+        row = null;
+    }
+
+    private int dp(int value) {
+        return Math.round(value * ime.getResources().getDisplayMetrics().density);
+    }
+
+    private void attachRow(View root) {
+        View holder = root.findViewById(KEYBOARD_HOLDER);
+        if (holder == null || !(holder.getParent() instanceof LinearLayout)) {
+            Log.w("AIGrammar", "Expected keyboard holder parent is absent");
+            return;
+        }
+        if (row != null && row.getParent() instanceof ViewGroup)
+            ((ViewGroup) row.getParent()).removeView(row);
+        LinearLayout parent = (LinearLayout) holder.getParent();
+        row = new LinearLayout(ime);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        row.setPadding(dp(8), dp(4), dp(8), dp(4));
+        row.setBackgroundColor(Color.rgb(31, 36, 44));
+        toggle = new TextView(ime);
+        toggle.setTextSize(13);
+        toggle.setTextColor(Color.WHITE);
+        toggle.setGravity(Gravity.CENTER);
+        toggle.setMinHeight(dp(48));
+        toggle.setPadding(dp(8), 0, dp(8), 0);
+        toggle.setFocusable(false);
+        toggle.setOnClickListener(view -> {
+            GrammarClient.setEnabled(!GrammarClient.isEnabled());
+            refreshToggle();
+        });
+        toggle.setOnLongClickListener(view -> {
+            ime.startActivity(new Intent(ime, SettingsActivity.class)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+            return true;
+        });
+        int icon = ime.getResources().getIdentifier("aigrammar_toggle", "drawable", ime.getPackageName());
+        if (icon != 0) {
+            Drawable drawable = ime.getDrawable(icon);
+            if (drawable != null) {
+                drawable.setBounds(0, 0, dp(24), dp(24));
+                toggle.setCompoundDrawables(drawable, null, null, null);
+                toggle.setCompoundDrawablePadding(dp(6));
+            }
+        }
+        row.addView(toggle, new LinearLayout.LayoutParams(-2, -2));
+        chip = new TextView(ime);
+        chip.setTextSize(14);
+        chip.setTextColor(Color.rgb(11, 45, 33));
+        chip.setGravity(Gravity.CENTER_VERTICAL);
+        chip.setMaxLines(2);
+        chip.setEllipsize(TextUtils.TruncateAt.END);
+        chip.setPadding(dp(10), dp(6), dp(10), dp(6));
+        chip.setMinHeight(dp(48));
+        chip.setFocusable(false);
+        GradientDrawable background = new GradientDrawable();
+        background.setColor(Color.rgb(183, 239, 206));
+        background.setCornerRadius(dp(14));
+        chip.setBackground(background);
+        chip.setOnClickListener(view -> applyCorrection());
+        row.addView(chip, new LinearLayout.LayoutParams(0, -2, 1));
+        parent.addView(row, parent.indexOfChild(holder), new LinearLayout.LayoutParams(-1, -2));
+        hideChip();
+        refreshToggle();
+    }
+
+    private boolean allowed() {
+        if (!active || row == null || !row.isShown() || !GrammarClient.isEnabled()
+                || !ime.isInputViewShown() || editor == null
+                || editor != ime.getCurrentInputEditorInfo() || cursorStart < 0
+                || cursorStart != cursorEnd) return false;
+        UserManager manager = (UserManager) ime.getSystemService(InputMethodService.USER_SERVICE);
+        return manager != null && manager.isUserUnlocked()
+                && EditorPolicy.allows(editor.inputType, editor.imeOptions, editor.packageName);
+    }
+
+    private Snapshot snapshot() {
+        // This check must precede getSelectedText/getTextBeforeCursor/getTextAfterCursor.
+        if (!allowed()) return null;
+        InputConnection connection = ime.getCurrentInputConnection();
+        if (connection == null) return null;
+        CharSequence selected = connection.getSelectedText(0);
+        if (selected != null && selected.length() > 0) return null;
+        CharSequence before = connection.getTextBeforeCursor(201, 0);
+        if (before == null) return null;
+        CharSequence after = connection.getTextAfterCursor(32, 0);
+        SentenceSlice slice = SentenceSlice.from(before.toString());
+        if (slice == null) return null;
+        return new Snapshot(connection, editor, revision, cursorStart, before.toString(),
+                after == null ? null : after.toString(), slice);
+    }
+
+    private boolean matches(Snapshot expected) {
+        Snapshot current = snapshot();
+        return current != null && current.connection == expected.connection
+                && current.editor == expected.editor && current.revision == expected.revision
+                && current.cursor == expected.cursor && current.before.equals(expected.before)
+                && TextUtils.equals(current.after, expected.after);
+    }
+
+    private void requestCorrection() {
+        try {
+            final Snapshot source = snapshot();
+            if (source == null || source.slice.text.equals(lastRequested)) return;
+            lastRequested = source.slice.text;
+            requesting = true;
+            GrammarClient.request(source.slice.text, new GrammarClient.Callback() {
+                @Override public void onResult(String corrected) {
+                    requesting = false;
+                    try {
+                        if (!matches(source)) { hideChip(); return; }
+                        // Restore the editor's original trailing spaces/newlines.
+                        String core = corrected.trim();
+                        if (core.isEmpty() || core.equals(source.slice.text)) { hideChip(); return; }
+                        offered = source;
+                        correction = core + source.slice.trailing;
+                        if (chip != null) {
+                            chip.setText(core);
+                            chip.setContentDescription("Apply grammar correction: " + core);
+                            chip.setVisibility(View.VISIBLE);
+                        }
+                    } catch (RuntimeException error) { hideChip(); }
+                }
+                @Override public void onError(String message) { requesting = false; hideChip(); }
+            });
+        } catch (RuntimeException error) { hideChip(); }
+    }
+
+    private void applyCorrection() {
+        try {
+            Snapshot source = offered;
+            String replacement = correction;
+            if (source == null || replacement == null || !matches(source)) { invalidate(); return; }
+            InputConnection connection = source.connection;
+            invalidate();
+            connection.beginBatchEdit();
+            try {
+                // Stop Gboard's composing span from replacing more than the checked suffix.
+                if (!connection.finishComposingText()) return;
+                // Recheck text after finishing composition before deleting anything.
+                CharSequence before = connection.getTextBeforeCursor(201, 0);
+                if (before == null || !source.before.contentEquals(before)) return;
+                CharSequence after = connection.getTextAfterCursor(32, 0);
+                CharSequence selected = connection.getSelectedText(0);
+                if (!TextUtils.equals(source.after, after)
+                        || (selected != null && selected.length() > 0)) return;
+                if (connection.deleteSurroundingText(source.slice.original.length(), 0)) {
+                    if (!connection.commitText(replacement, 1)) {
+                        // Best-effort restoration when an editor explicitly rejects the commit.
+                        connection.commitText(source.slice.original, 1);
+                    }
+                }
+            } finally { connection.endBatchEdit(); }
+        } catch (RuntimeException error) {
+            Log.w("AIGrammar", "Editor rejected grammar replacement");
+            invalidate();
+        }
+    }
+
+    private void hideChip() {
+        offered = null;
+        correction = null;
+        if (chip != null) {
+            chip.setText("");
+            chip.setContentDescription(null);
+            chip.setVisibility(View.GONE);
+        }
+    }
+
+    private void invalidate() {
+        revision++;
+        handler.removeCallbacks(timer);
+        // Excluded fields can be our own SettingsActivity. Do not cancel its Test request.
+        if (requesting) GrammarClient.cancelPending();
+        requesting = false;
+        hideChip();
+    }
+
+    private void refreshToggle() {
+        if (toggle == null) return;
+        boolean enabled = GrammarClient.isEnabled();
+        toggle.setActivated(enabled);
+        toggle.setText(enabled ? "AI Grammar ON" : "AI Grammar OFF");
+        toggle.setContentDescription(toggle.getText() + ". Long-press for settings.");
+    }
+
+    @Override public void onSharedPreferenceChanged(SharedPreferences prefs, String key) {
+        if (!"enabled".equals(key) && !"api_key".equals(key) && !"model".equals(key)) return;
+        invalidate();
+        lastRequested = null;
+        refreshToggle();
+        if (allowed()) handler.postDelayed(timer, 700);
+    }
+
+    private static final class Snapshot {
+        final InputConnection connection;
+        final EditorInfo editor;
+        final long revision;
+        final int cursor;
+        final String before;
+        final String after;
+        final SentenceSlice slice;
+        Snapshot(InputConnection connection, EditorInfo editor, long revision, int cursor,
+                String before, String after, SentenceSlice slice) {
+            this.connection = connection; this.editor = editor; this.revision = revision;
+            this.cursor = cursor; this.before = before; this.after = after; this.slice = slice;
+        }
+    }
+}
diff --git a/aigrammar/src/com/aigrammar/GrammarClient.java b/aigrammar/src/com/aigrammar/GrammarClient.java
new file mode 100644
index 00000000..ec353305
--- /dev/null
+++ b/aigrammar/src/com/aigrammar/GrammarClient.java
@@ -0,0 +1,166 @@
+package com.aigrammar;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserManager;
+import org.json.JSONObject;
+import org.json.JSONArray;
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.concurrent.Future;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+
+/** No key or editor text is logged. The IME caller owns debounce and field policy. */
+public final class GrammarClient {
+    public interface Callback {
+        void onResult(String corrected);
+        void onError(String msg);
+    }
+
+    public static final String DEFAULT_MODEL = "gemini-3.5-flash-lite";
+    private static final String INSTRUCTION = "Fix grammar, spelling and punctuation only. Keep the meaning, tone, language and emojis. Return ONLY the corrected text, no quotes, no explanation. If already correct, return it unchanged.";
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+    private static final ThreadPoolExecutor WORKER = new ThreadPoolExecutor(
+            1, 1, 0L, TimeUnit.MILLISECONDS, new LinkedBlockingQueue<Runnable>());
+    private static final AtomicLong REQUEST = new AtomicLong();
+    private static volatile SharedPreferences preferences;
+    private static Future<?> pending;
+
+    private GrammarClient() {}
+
+    public static synchronized void init(Context context) {
+        // The IME is directBootAware; never read credential storage while locked.
+        UserManager manager = (UserManager) context.getSystemService(Context.USER_SERVICE);
+        if (manager == null || !manager.isUserUnlocked()) return;
+        if (preferences == null) {
+            preferences = context.getApplicationContext().getSharedPreferences(
+                    "aigrammar_prefs", Context.MODE_PRIVATE);
+        }
+    }
+
+    static SharedPreferences preferences() { return preferences; }
+
+    public static boolean isEnabled() {
+        SharedPreferences p = preferences;
+        return p != null && p.getBoolean("enabled", false);
+    }
+
+    public static void setEnabled(boolean enabled) {
+        if (!enabled) cancelPending();
+        SharedPreferences p = preferences;
+        if (p != null) p.edit().putBoolean("enabled", enabled).apply();
+    }
+
+    public static synchronized void cancelPending() {
+        REQUEST.incrementAndGet();
+        if (pending != null) pending.cancel(true);
+        pending = null;
+        WORKER.purge();
+    }
+
+    public static synchronized void request(final String text, final Callback cb) {
+        cancelPending();
+        final long token = REQUEST.get();
+        final SharedPreferences p = preferences;
+        if (cb == null) return;
+        if (text == null || text.length() < 3) {
+            deliver(token, cb, null, "Enter at least 3 characters");
+            return;
+        }
+        if (p == null) {
+            deliver(token, cb, null, "Unlock the device first");
+            return;
+        }
+        final String key = p.getString("api_key", "").trim();
+        final String model = p.getString("model", DEFAULT_MODEL).trim();
+        if (key.isEmpty()) {
+            deliver(token, cb, null, "Set an API key first");
+            return;
+        }
+        // Prevent a model value from changing the URL path or adding a query.
+        if (!model.matches("[A-Za-z0-9][A-Za-z0-9._-]{0,127}")) {
+            deliver(token, cb, null, "Invalid model ID (use the bare model name)");
+            return;
+        }
+        pending = WORKER.submit(new Runnable() {
+            @Override public void run() {
+                HttpURLConnection connection = null;
+                try {
+                    if (token != REQUEST.get()) return;
+                    JSONObject body = new JSONObject()
+                            .put("systemInstruction", new JSONObject().put("parts",
+                                    new JSONArray().put(new JSONObject().put("text", INSTRUCTION))))
+                            .put("contents", new JSONArray().put(new JSONObject().put("parts",
+                                    new JSONArray().put(new JSONObject().put("text", text)))))
+                            .put("generationConfig", new JSONObject()
+                                    .put("temperature", 0.1).put("maxOutputTokens", 256));
+                    byte[] bytes = body.toString().getBytes("UTF-8");
+                    connection = (HttpURLConnection) new URL(
+                            "https://generativelanguage.googleapis.com/v1beta/models/"
+                            + model + ":generateContent").openConnection();
+                    connection.setConnectTimeout(5000);
+                    connection.setReadTimeout(8000);
+                    connection.setInstanceFollowRedirects(false);
+                    connection.setRequestMethod("POST");
+                    connection.setRequestProperty("Content-Type", "application/json");
+                    connection.setRequestProperty("x-goog-api-key", key);
+                    connection.setDoOutput(true);
+                    connection.setFixedLengthStreamingMode(bytes.length);
+                    if (token != REQUEST.get()) return;
+                    try (OutputStream out = connection.getOutputStream()) { out.write(bytes); }
+                    int status = connection.getResponseCode();
+                    if (status != 200) {
+                        deliver(token, cb, null, "Gemini HTTP " + status);
+                        return;
+                    }
+                    ByteArrayOutputStream result = new ByteArrayOutputStream();
+                    try (InputStream in = connection.getInputStream()) {
+                        byte[] buffer = new byte[4096];
+                        int count;
+                        while ((count = in.read(buffer)) != -1) {
+                            if (token != REQUEST.get()) return;
+                            if (result.size() + count > 65536) throw new java.io.IOException();
+                            result.write(buffer, 0, count);
+                        }
+                    }
+                    JSONObject candidate = new JSONObject(result.toString("UTF-8"))
+                            .getJSONArray("candidates").getJSONObject(0);
+                    if (!"STOP".equals(candidate.optString("finishReason", "STOP"))) {
+                        deliver(token, cb, null, "No complete correction returned");
+                        return;
+                    }
+                    String corrected = candidate.getJSONObject("content").getJSONArray("parts")
+                            .getJSONObject(0).getString("text");
+                    if (corrected.trim().isEmpty()) {
+                        deliver(token, cb, null, "Empty correction returned");
+                    } else {
+                        deliver(token, cb, corrected, null);
+                    }
+                } catch (Exception error) {
+                    // Do not expose exception messages: HTTP errors can contain credentials/text.
+                    deliver(token, cb, null, "Request failed (network, timeout, or response format)");
+                } finally {
+                    if (connection != null) connection.disconnect();
+                }
+            }
+        });
+    }
+
+    private static void deliver(final long token, final Callback cb,
+            final String corrected, final String error) {
+        MAIN.post(new Runnable() {
+            @Override public void run() {
+                if (token != REQUEST.get()) return;
+                if (error == null) cb.onResult(corrected); else cb.onError(error);
+            }
+        });
+    }
+}
diff --git a/aigrammar/src/com/aigrammar/SentenceSlice.java b/aigrammar/src/com/aigrammar/SentenceSlice.java
new file mode 100644
index 00000000..0817ee62
--- /dev/null
+++ b/aigrammar/src/com/aigrammar/SentenceSlice.java
@@ -0,0 +1,39 @@
+package com.aigrammar;
+
+/** A bounded sentence suffix. Never replace a truncated prefix of a long sentence. */
+public final class SentenceSlice {
+    public final String original;
+    public final String text;
+    public final String trailing;
+
+    private SentenceSlice(String original, String text, String trailing) {
+        this.original = original;
+        this.text = text;
+        this.trailing = trailing;
+    }
+
+    public static SentenceSlice from(String before) {
+        if (before == null || before.isEmpty() || before.length() > 201) return null;
+        int end = before.length();
+        while (end > 0 && Character.isWhitespace(before.charAt(end - 1))) end--;
+        if (end == 0) return null;
+        int start = 0;
+        // Ignore a terminal punctuation mark: the just-completed sentence is useful too.
+        for (int i = end - 2; i >= 0; i--) {
+            char c = before.charAt(i);
+            boolean punctuation = ".!?。！？؟".indexOf(c) >= 0;
+            if (c == '\n' || c == '\r' || (punctuation &&
+                    (Character.isWhitespace(before.charAt(i + 1)) || c > 127))) {
+                start = i + 1;
+                break;
+            }
+        }
+        if (before.length() == 201 && start == 0) return null;
+        while (start < end && Character.isWhitespace(before.charAt(start))) start++;
+        if (end - start < 3 || before.length() - start > 200) return null;
+        // Do not split a surrogate pair even if the editor truncates a string oddly.
+        if (Character.isLowSurrogate(before.charAt(start))) return null;
+        return new SentenceSlice(before.substring(start), before.substring(start, end),
+                before.substring(end));
+    }
+}
