+        editor.afterSurrounding = new Runnable() {
+            @Override public void run() { editor.text += " Changed remotely."; }
+        };
+        assertNull(FullTextSnapshot.capture(editor, 4, 4));
+        assertTrue(editor.extractCalls >= 2);
