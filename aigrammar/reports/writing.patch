+        assertFalse(snapshot.apply(editor, null));
+        assertFalse(snapshot.apply(editor, " \n\t "));
+        assertFalse(snapshot.apply(editor, repeat("x", FullTextSnapshot.MAX_TEXT_CHARS * 2 + 1)));
